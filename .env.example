# PSEUDO_KEY: secret key used by notebook 01b to pseudonymise review_id
# (HMAC-SHA256 of the store id, first 12 hex characters).
#
# Generate your own key in the project venv:
#   python -c "import secrets; print(secrets.token_hex(32))"
# then copy this file to .env and replace change_me with the output.
#
# Never commit the key: .env is gitignored, and only this template is tracked.
# Changing the key changes every pseudonymised review_id, so ids produced with
# different keys cannot be joined.
PSEUDO_KEY=change_me
